# Carebridge Backend Environment Configuration
PORT=8000
DATABASE_URL=sqlite:///./carebridge.db

# Google Identity Services (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Cloud Vision AI OCR Service Account
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-vision-key.json

# UIDAI Aadhaar Compliance Policy
# NEVER STORE 12-DIGIT AADHAAR NUMBERS
AADHAAR_UID_MASKING=ENABLED
